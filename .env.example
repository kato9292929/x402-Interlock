# ---- x402 Interlock (server only; never exposed to the browser) ----
# Shared secret the demo agent sends to the gate API
AGENT_TOKEN=change-me
# Base URL the agent / approval links use
PUBLIC_BASE_URL=http://localhost:3000

# Buyer wallet (Base Sepolia test wallet with test USDC). Only the gate server holds it.
BUYER_PRIVATE_KEY=0x...

# Payment addresses (Base Sepolia). config/policy.json reads its allowlist from these
# via "env:SELLER_PAY_TO", so the allowlist needs no editing.
SELLER_PAY_TO=0x...          # demo seller's TESTNET wallet (receives the test USDC)
RISKY_PAY_TO=0x...           # testnet payTo of the "risky" demo seller (any wallet you control)

# Screening addresses (Base MAINNET). Intercepta's risk data is mainnet-only, so each
# testnet payTo is screened as the mainnet address below (config/policy.json screening.targets).
SELLER_MAINNET_ADDRESS=0x... # a clean mainnet address standing in for the seller
RISKY_MAINNET_ADDRESS=0x...  # the risky address pinned in Intercepta's ETHGlobal Discord channel

# Intercepta (https://intercepta.io/ethglobal)
INTERCEPTA_API_KEY=
# INTERCEPTA_BASE_URL=https://api.web3antivirus.io

# World ID (developer.world.org). v4 RPs can only be registered in a PRODUCTION app:
# create a production app, register the Relying Party inside it, and copy app_id, rp_id
# and the RP signing key from there.
NEXT_PUBLIC_WORLD_APP_ID=app_...
WORLD_RP_ID=rp_...
WORLD_SIGNING_KEY=
# production (default). Sandbox verification is refused with environment_not_allowed.
WORLD_ENVIRONMENT=production
# Sandbox/staging verification API key. Sent ONLY when WORLD_ENVIRONMENT is sandbox or
# staging, never for production. The official docs (checked 2026-09-26) do not say which
# header carries it, so set the header name too once it is confirmed. Set both or neither.
# WORLD_API_KEY=
# WORLD_API_KEY_HEADER=
# WORLD_APPROVAL_TTL_SECONDS=180
# WORLD_REQUIRE_USER_PRESENCE=0  # default 0; =1 adds World App face check (failed in live testing)
# WORLD_OWNER_NULLIFIER=       # pin the owner; otherwise the first approver is pinned (data/owner.json)
# WORLD_ACTION_PER_DECISION=0  # 1 = per-decision action, no owner pinning (fallback)

# ---- Tasks on Solana (Colosseum build) ----
# Owner-only credential for POST /api/tasks and /api/tasks/{id}/close. Must differ from AGENT_TOKEN.
OWNER_TOKEN=change-me-too
SOLANA_RPC_URL=https://api.devnet.solana.com
# SOLANA_RPC_WS_URL=wss://api.devnet.solana.com   # confirmations; default: SOLANA_RPC_URL with http->ws
# SOLANA_NETWORK=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1   # devnet (default)
# SOLANA_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU  # devnet USDC (default)
# base58 64-byte secret keys (solana-keygen / Phantom export format)
GATE_SOLANA_PRIVATE_KEY=     # the gate: Allowance delegatee and x402 payer. Needs devnet SOL for fees.
OWNER_SOLANA_PRIVATE_KEY=    # the owner: holds the USDC, creates/revokes Allowances. Needs devnet SOL + devnet USDC.
AGENT_SOLANA_ADDRESS=        # the agent's public key; issuance refuses to delegate to it
SELLER_SOLANA_PAY_TO=        # demo seller's Solana address (receives devnet USDC)
# EVM stand-in used as `from` for Intercepta's Scan Message when BUYER_PRIVATE_KEY is not set
# SCREENING_FROM_ADDRESS=0x...

# ---- Agent Procurement Policy Engine (spec/07) ----
# TypeSafe API key for Jev (console.typesafe.ai). Unset: Spend Guard records UNAVAILABLE.
TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=https://api.typesafe.ai   # default

